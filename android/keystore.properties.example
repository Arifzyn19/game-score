# Copy this file to android/keystore.properties and fill in real values to enable
# signed release builds. NEVER commit the actual keystore.properties or keystore.
#   cp keystore.properties.example keystore.properties
#   keytool -genkeypair -v -keystore release.keystore -alias scoreboard -keyalg RSA -keysize 2048 -validity 10000
#   ./gradlew :app:assembleRelease
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=scoreboard
keyPassword=CHANGE_ME